{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*service-account*.json)",
      "Read(**/*serviceAccount*.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(cut *.env*)",
      "Bash(grep * .env*)",
      "Bash(sed * .env*)",
      "Bash(awk * .env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(type *.env*)",
      "Read(**/다운로드한키.json)",
      "Read(**/*firebase-adminsdk*.json)"
    ]
  }
}